{
  "name": "bussola-civica",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrar": "node --experimental-strip-types src/db/migrar.ts",
    "db:validar": "node --env-file-if-exists=.env --experimental-strip-types src/db/validar.ts",
    "ingerir": "node --env-file-if-exists=.env --experimental-strip-types src/ingest/index.ts",
    "ingerir:incremental": "node --env-file-if-exists=.env --experimental-strip-types src/ingest/incremental.ts",
    "relatorio": "node --env-file-if-exists=.env --experimental-strip-types src/relatorio.ts",
    "site": "node --experimental-strip-types src/site/gerar.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2"
  }
}
