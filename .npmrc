# Versão de Node incompatível vira erro de instalação, não aviso.
#
# Sem isto o npm só emite `EBADENGINE` e instala assim mesmo — e a falha real
# aparece depois, na primeira execução, como erro de sintaxe do TypeScript:
# abaixo do 22.6 não existe `--experimental-strip-types`, e o projeto roda sem
# passo de build. Errar no `npm install` diz o que fazer; errar no `npm run
# ingerir` faz procurar bug no lugar errado.
engine-strict=true
